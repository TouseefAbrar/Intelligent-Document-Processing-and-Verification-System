# =============================================================================
# EEF Backend environment — copy to .env and fill in your values
# =============================================================================

# --- App ---------------------------------------------------------------------
DEBUG=false
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_SIZE_MB=25

# --- Groq (REQUIRED for best OCR + classification + extraction + analysis) ----
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# --- Database ----------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./ezitech.db
# PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+psycopg://eef:eef@localhost:5432/eef

# --- OCR ---------------------------------------------------------------------
# auto = Groq vision (if available on the account) → Tesseract → EasyOCR(optional)
OCR_PROVIDER=auto
# Full path to the Tesseract binary (Windows). Linux/macOS: leave as tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Verification thresholds --------------------------------------------------
BLUR_VARIANCE_THRESHOLD=100
DUPLICATE_HASH_THRESHOLD=0.90

# Document types required for a complete submission
COMPLETENESS_REQUIRED_DOCS=["resume","cnic","offer_letter","degree","transcript"]

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

LOG_LEVEL=INFO
